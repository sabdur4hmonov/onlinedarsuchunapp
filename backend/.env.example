# Copy this file to `.env` and fill in real values:
#   copy .env.example .env
# Never commit the real `.env` file.

# --- PostgreSQL (used by docker-compose) ---
POSTGRES_USER=course_user
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=course_platform
POSTGRES_PORT=5432

# --- App database connections ---
DATABASE_URL=postgresql+asyncpg://course_user:change-me-strong-password@localhost:5432/course_platform
# Separate database for pytest (tests wipe it on every run!)
TEST_DATABASE_URL=postgresql+asyncpg://course_user:change-me-strong-password@localhost:5432/course_platform_test

# --- JWT ---
# Generate a long random value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Security rules ---
MAX_STUDENT_DEVICES=2
DEVICE_BINDING_TOKEN_EXPIRE_MINUTES=5
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
# Current version of consent texts. Bump it when texts change -> students must re-consent.
CONSENT_VERSION=1.0

# "development" or "production". In production the server refuses to start without VdoCipher.
ENVIRONMENT=development

# --- Video: VdoCipher (DRM + watermark) ---
# Leave EMPTY to use the built-in mock provider (development/tests, no real DRM).
# Get it at: VdoCipher dashboard -> Config -> API Keys
VDOCIPHER_API_SECRET=
VDOCIPHER_API_BASE_URL=https://dev.vdocipher.com/api
# Random value; the webhook URL registered in VdoCipher must end with ?token=<this value>
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
VDOCIPHER_WEBHOOK_SECRET=
# Playback OTP lifetime, max 300 (5 minutes)
PLAYBACK_OTP_TTL_SECONDS=300
PLAYBACK_RATE_LIMIT_ATTEMPTS=10
PLAYBACK_RATE_LIMIT_WINDOW_SECONDS=60

# --- Live lessons: LiveKit ---
# Leave LIVEKIT_API_KEY / LIVEKIT_API_SECRET EMPTY to use the built-in mock (no real video).
# Local LiveKit (docker compose --profile live up -d): fill both, the same values are used by the container.
#   python -c "import secrets; print('API' + secrets.token_hex(6)); print(secrets.token_urlsafe(48))"
LIVEKIT_URL=ws://localhost:7880
# Backend -> LiveKit server API; empty = derived from LIVEKIT_URL (ws->http, wss->https)
LIVEKIT_API_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Where LiveKit (in Docker) sends webhooks: the backend running on this computer
LIVEKIT_WEBHOOK_URL=http://host.docker.internal:8000/webhooks/livekit
# Media IP announced to clients. Phone on the same Wi-Fi: this computer's LAN IP + LIVEKIT_BIND_IP=0.0.0.0
LIVEKIT_NODE_IP=127.0.0.1
LIVEKIT_BIND_IP=127.0.0.1
LIVE_STUDENT_TOKEN_TTL_MINUTES=10
LIVE_TEACHER_TOKEN_TTL_MINUTES=60
LIVE_ROOM_EMPTY_TIMEOUT_SECONDS=600
LIVE_JOIN_RATE_LIMIT_ATTEMPTS=10
LIVE_JOIN_RATE_LIMIT_WINDOW_SECONDS=60

# --- Temporary storage for raw recordings (MinIO locally, S3/R2 in production) ---
# Leave RECORDINGS_S3_ACCESS_KEY / SECRET_KEY EMPTY to use in-memory mock storage.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# Backend side (presigned URLs, deleting files). Empty = real AWS S3.
RECORDINGS_S3_ENDPOINT_URL=http://localhost:9000
# Recorder (egress container) side
RECORDINGS_S3_EGRESS_ENDPOINT_URL=http://minio:9000
RECORDINGS_S3_BUCKET=live-recordings
RECORDINGS_S3_REGION=us-east-1
# Locally the same as MINIO_ROOT_USER / MINIO_ROOT_PASSWORD
RECORDINGS_S3_ACCESS_KEY=
RECORDINGS_S3_SECRET_KEY=
RECORDINGS_PRESIGNED_URL_TTL_SECONDS=1800
