# Copy to .env.local:   copy .env.example .env.local
# .env.local is never committed.

# FastAPI backend, reached by the PANEL SERVER (browsers never talk to it for API calls)
BACKEND_URL=http://127.0.0.1:8000

# Public address of this panel. Used for CSRF (Origin) checks. In production: https://panel.example.uz
PANEL_ORIGIN=http://localhost:3000

# Secure cookies. Keep "true" (browsers accept Secure cookies on http://localhost too).
# Only for testing over plain http from another device (LAN IP) set to "false".
COOKIE_SECURE=true

# Extra hosts the browser may connect to (Content-Security-Policy connect-src), space-separated:
#  - LiveKit server for live lessons (ws://... locally, wss://... in production)
#  - where videos are uploaded: VdoCipher storage (https://*.amazonaws.com) or, in mock mode,
#    the backend's /dev/mock-video-upload
CSP_CONNECT_SRC=ws://localhost:7880 http://localhost:8000 https://*.amazonaws.com
